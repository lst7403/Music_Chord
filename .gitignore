# Ignore all contents in data directory
data/*

# Do not ignore .gitkeep so the data directory is preserved
!data/.gitkeep

# Python & Jupyter cache
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Python Virtual Environments & Local Packages
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Distribution & Build Artifacts
build/
dist/
*.egg-info/
*.egg
*.whl
pip-wheel-metadata/

# AI Agents & Tools
.agent/*
.agents/
.gemini/
graphify-out/
.cursor/
.claude/
.cline/
.aidev/

# Logs & Local Config
*.log
server.log
.env
.env.local
.env.*

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
